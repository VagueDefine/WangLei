views:
  - type: cards
    name: 高速电路设计
    filters:
      and:
        - file.tags.contains("高速电路设计")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.basename
      - author
      - created
      - tags
      - source
      - file.mtime
      - description
    sort: []
    indentProperties: false
    cardSize: 240
    imageAspectRatio: 1
  - type: cards
    name: 文档
    filters:
      and:
        - file.ext.contains("pdf")
        - file.folder == "300高速电路设计与电磁兼容技术指南/资料"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.ctime
      - file.embeds
      - file.ext
      - author
      - description
      - source
      - tags
    cardSize: 300
