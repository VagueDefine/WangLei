views:
  - type: cards
    name: obsidian教程
    filters:
      and:
        - file.tags.contains("obsidian教程")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.basename
      - created
      - author
      - description
      - tags
      - file.mtime
      - source
    sort:
      - property: tags
        direction: ASC
    cardSize: 330
  - type: cards
    name: 问题与配置
    filters:
      and:
        - file.folder == "200问题和配置教程"
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - file.basename
      - created
      - author
      - description
      - tags
      - file.mtime
      - source
    cardSize: 340
  - type: cards
    name: GitHub教程
    filters:
      and:
        - file.tags.contains("GitHub教程")
    order:
      - file.name
      - file.basename
      - author
      - created
      - file.mtime
      - description
      - tags
      - source
    cardSize: 320
